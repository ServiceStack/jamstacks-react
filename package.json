{
  "name": "jamstacks",
  "version": "0.1.0",
  "description": "Shared React components and theme utilities for Jamstacks templates.",
  "license": "BSD-3-Clause",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/ServiceStack/jamstacks-react.git" },
  "homepage": "https://github.com/ServiceStack/jamstacks-react#readme",
  "bugs": { "url": "https://github.com/ServiceStack/jamstacks-react/issues" },
  "keywords": ["jamstacks", "react", "components", "dark-mode", "nextjs"],
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server.d.ts", "import": "./dist/server.js", "default": "./dist/server.js" },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json",
    "test": "npm run build && node --test tests/package.test.mjs && playwright test",
    "test:browser": "playwright test",
    "bump": "npm version patch && git push origin main --follow-tags",
    "bump:minor": "npm version minor && git push origin main --follow-tags",
    "bump:major": "npm version major && git push origin main --follow-tags",
    "release": "node scripts/release.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0", "react-dom": "^18.2.0 || ^19.0.0" },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" }
}
